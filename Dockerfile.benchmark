# syntax=docker/dockerfile:1.4

FROM rustlang/rust:nightly-bookworm AS builder

RUN apt-get update && apt-get install -y \
    ca-certificates \
    git \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=stoffelvm . /StoffelVM

WORKDIR /build

COPY . /build

RUN --mount=type=cache,id=stoffel-coord-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=stoffel-coord-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=stoffel-coord-target,target=/build/target,sharing=locked \
    cargo build --release --features benchmark && \
    strip target/release/run-coord && \
    mkdir -p /build/artifacts && \
    cp target/release/run-coord /build/artifacts/run-coord

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    net-tools \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/artifacts/run-coord /app/run-coord

ENTRYPOINT ["/app/run-coord"]
